<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.9" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Real, published PlaxionMediator OSS packages, used to prove genuine
         OTLP-exported PlaxionMediator telemetry reaches Platform.Ingestion
         and Platform.Api end-to-end (see TwoTenantRealOtlpAcceptanceTests). -->
    <PackageReference Include="PlaxionMediator" Version="1.0.0" />
    <PackageReference Include="PlaxionMediator.OpenTelemetry" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Platform.Api\Platform.Api.csproj" />
    <ProjectReference Include="..\..\src\Platform.Ingestion\Platform.Ingestion.csproj">
      <Aliases>IngestionHost</Aliases>
    </ProjectReference>
  </ItemGroup>

</Project>
