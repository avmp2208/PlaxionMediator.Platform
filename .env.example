# PostgreSQL Configuration
POSTGRES_PASSWORD=plaxion_secret

# Platform Configuration
# API_BASE_URL: Set this if the Dashboard needs to connect to an API at a different origin.
# By default (empty), it uses the same origin as the Dashboard files.
API_BASE_URL=

# Dashboard OIDC (public SPA client — never put a client secret here)
# Authentication__Enabled=true
# Authentication__Authority=https://login.example.com/
# Authentication__Audience=platform-api
# Dashboard__Oidc__ClientId=platform-dashboard
# Dashboard__Oidc__Scopes=openid profile email
