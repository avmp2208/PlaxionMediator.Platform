{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "Environment": "Production"
  },
  "Storage": {
    "Provider": "PostgreSql"
  },
  "Database": {
    "AutoMigrate": false,
    "FailOnPendingMigrations": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Aggregation": {
    "Interval": "00:01:00",
    "BucketSize": "00:01:00"
  },
  "Retention": {
    "RawSampleRetention": "7.00:00:00",
    "CheckInterval": "00:05:00"
  },
  "Authentication": {
    "Enabled": false,
    "AllowAnonymousProduction": false
  }
}
