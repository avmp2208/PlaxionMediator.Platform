{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Platform": {
    "Environment": "Development",
    "PublicBaseUrl": "http://localhost:5095"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4600" ]
  },
  "ConnectionStrings": {
    "Platform": "Data Source=platform-api.db"
  },
  "Storage": {
    "Provider": "InMemory"
  },
  "Aggregation": {
    "Interval": "00:01:00",
    "BucketSize": "00:01:00"
  },
  "Retention": {
    "RawSampleRetention": "7.00:00:00",
    "CheckInterval": "00:05:00"
  },
  "Database": {
    "FailOnPendingMigrations": true
  },
  "Observability": {
    "OtlpEndpoint": null,
    "OtlpHeaders": null
  },
  "Ingestion": {
    "MaxRequestSizeBytes": 1048576,
    "MaxSamplesPerRequest": 5000,
    "MaxMetricNamesPerRequest": 200
  },
  "Authentication": {
    "Enabled": false,
    "Authority": null,
    "Audience": null,
    "RequireHttpsMetadata": true,
    "AllowAnonymousProduction": false
  },
  "Dashboard": {
    "ApiBaseUrl": null,
    "Oidc": {
      "ClientId": null,
      "Scopes": [ "openid", "profile", "email" ],
      "RedirectPath": "/auth/callback",
      "PostLogoutRedirectPath": "/"
    }
  },
  "Authorization": {
    "TenantCreation": {
      "Mode": "AnyAuthenticatedUser",
      "RequiredRole": null,
      "RequiredClaimType": null,
      "RequiredClaimValues": []
    },
    "PlatformAdministrator": {
      "Mode": "Disabled",
      "RequiredRole": null,
      "RequiredClaimType": null,
      "RequiredClaimValues": []
    }
  }
}
