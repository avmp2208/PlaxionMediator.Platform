{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4600" ]
  },
  "ConnectionStrings": {
    "Platform": "Data Source=platform-api.db"
  },
  "Storage": {
    "Provider": "InMemory"
  },
  "Retention": {
    "RawSampleRetention": "7.00:00:00",
    "CheckInterval": "00:05:00"
  }
}
