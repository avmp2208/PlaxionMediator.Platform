{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "Environment": "Staging"
  },
  "Storage": {
    "Provider": "PostgreSql"
  },
  "Database": {
    "AutoMigrate": false,
    "FailOnPendingMigrations": true
  },
  "Ingestion": {
    "MaxRequestSizeBytes": 1048576,
    "MaxSamplesPerRequest": 5000,
    "MaxMetricNamesPerRequest": 200
  }
}
